{
  "name": "@denisvieiradev/gitwise",
  "version": "1.3.0",
  "description": "AI-powered git toolbelt: intelligent commit, code review, PR drafting, and versioned releases.",
  "type": "module",
  "bin": {
    "gw": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node --experimental-vm-modules ../../node_modules/.bin/jest --passWithNoTests",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@denisvieiradev/gitwise-core": "1.3.0",
    "@denisvieiradev/gitwise-skills": "1.3.0",
    "@clack/prompts": "^1.8.1",
    "chalk": "^6.0.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "gitwise",
    "git",
    "ai",
    "commit",
    "review",
    "pull-request",
    "release"
  ],
  "author": "Denis Vieira <denisvieira05@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denisvieiradev/gitwise.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/denisvieiradev/gitwise/issues"
  },
  "homepage": "https://github.com/denisvieiradev/gitwise#readme",
  "engines": {
    "node": ">=22.12.0"
  }
}
